# =============================================================================
# Starfish CI Build Image — Ubuntu 24.04 (noble)
#
# Replaces the legacy starfish-build:20.04 image.
# Includes all build + test dependencies for native x64 builds and reftest/WPT
# test execution.
#
# Build:
#   docker build -f docker/Dockerfile.starfish-build \
#     -t lws-docker-local.bart.sec.samsung.net/starfish-build:24.04 .
#
# Push to bart registry:
#   docker push lws-docker-local.bart.sec.samsung.net/starfish-build:24.04
# =============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

# ---------------------------------------------------------------------------
# Core build toolchain
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        curl \
        wget \
        ca-certificates \
        autoconf \
        automake \
        libtool \
        patchelf \
        clang \
        clang-format \
        rsync \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

# squash_thirdparty (tool/release/prepare_source_without_thirdparty.sh) pushes
# over an ssh git@github.sec.samsung.net remote. Pre-seed its host key so that
# push doesn't hit ssh's interactive "Host key verification failed" prompt in
# CI -- the legacy 20.04 image had this baked into ~/.ssh/known_hosts already.
RUN mkdir -p /etc/ssh && \
    echo 'github.sec.samsung.net ssh-rsa ' \
        >> /etc/ssh/ssh_known_hosts

# ---------------------------------------------------------------------------
# Starfish build dependencies (from README "Install required packages")
# ---------------------------------------------------------------------------
# libjpeg-dev: provides jpeglib.h (libturbojpeg0-dev only provides turbojpeg.h)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-dev \
        libcairo2-dev \
        libfreetype-dev \
        libfontconfig-dev \
        libharfbuzz-dev \
        libx11-dev \
        libxext-dev \
        libxrender-dev \
        libxi-dev \
        libegl-dev \
        libgles-dev \
        libgl1-mesa-dev \
        libpng-dev \
        libturbojpeg0-dev \
        libjpeg-dev \
        libgif-dev \
        libwebp-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libicu-dev \
        libcap-dev \
        libasound2-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Python 3 (default on noble is 3.12) + Jinja2 for binding generator
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-jinja2 \
        python3-venv \
        python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Test infrastructure: Xvfb for headless rendering, image diff tools
# ---------------------------------------------------------------------------
# fontconfig: provides fc-cache/fc-match, required by install_pixel_test_dep
# (libfontconfig-dev only provides dev headers, not the CLI tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        xauth \
        imagemagick \
        fonts-dejavu-core \
        fonts-liberation \
        fontconfig \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Test workspace: fonts baked into the image
# ---------------------------------------------------------------------------

# Ahem.ttf — standard WPT reference font used by reftest/internal tests.
# Bundled in docker/ to avoid cloning the test submodule during image build.
# Pre-install to ~/.fonts so tests can run without a separate copy step.
COPY docker/Ahem.ttf /root/workspace/Ahem.ttf
RUN mkdir -p /root/.fonts && cp /root/workspace/Ahem.ttf /root/.fonts/Ahem.ttf
RUN fc-cache -f

# When host directories are bind-mounted into the container (e.g. -v flag),
# Git detects a mismatch between the repo owner and the container user,
# raising "fatal: detected dubious ownership". This is required for local
# development builds and CI steps that mount the workspace.
RUN git config --global --add safe.directory '*'

WORKDIR /workspace

# Default shell — bash for consistent scripting in CI steps
SHELL ["/bin/bash", "-c"]
