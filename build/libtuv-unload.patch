+
+
+/* The shared library can be unloaded after its loops have been closed.
+ * These process-wide lock descriptors do not belong to an individual loop.
+ */
+UV_DESTRUCTOR(static void uv__signal_global_cleanup(void)) {
+  if (uv__signal_lock_pipefd[0] != -1) {
+    uv__close(uv__signal_lock_pipefd[0]);
+    uv__signal_lock_pipefd[0] = -1;
+  }
+  if (uv__signal_lock_pipefd[1] != -1) {
+    uv__close(uv__signal_lock_pipefd[1]);
+    uv__signal_lock_pipefd[1] = -1;
+  }
