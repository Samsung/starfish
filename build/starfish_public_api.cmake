CMAKE_MINIMUM_REQUIRED (VERSION 2.8)

SET (STARFISH_API_INCLUDE_DIRS
    ${STARFISH_ROOT}/inc
    ${STARFISH_ROOT}/src/
)

IF (${MODE} STREQUAL "debug")
    SET (STARFISH_API_DEFINES
        -D_GLIBCXX_DEBUG
    )
ELSEIF (${MODE} STREQUAL "release")
    SET (STARFISH_API_DEFINES -DNDEBUG)
ENDIF()

SET (STARFISH_API_OBJECT_LIBRARY starfish_api_object_library)
ADD_LIBRARY (${STARFISH_API_OBJECT_LIBRARY} OBJECT
    ${STARFISH_ROOT}/src/public/LWEWebView.cpp
    ${STARFISH_ROOT}/src/public/LWEDelegateLoader.cpp
)

SET (STARFISH_API_LDFLAGS ${LWE_LDFLAGS})
SET (STARFISH_API_LINK_LIBRARIES "")

IF (${HOST} STREQUAL "tizen")
    SET (STARFISH_API_UWE_MOUNT_PATH "${TIZEN_DATA_DIR}/lwe/update/")
    SET (STARFISH_API_DEFAULT_PATH "${LIBDIR}/lwe/")
ELSE ()
    SET (STARFISH_API_UWE_MOUNT_PATH "./update/")
    SET (STARFISH_API_DEFAULT_PATH "./")
ENDIF ()

TARGET_INCLUDE_DIRECTORIES (${STARFISH_API_OBJECT_LIBRARY} PUBLIC ${STARFISH_API_INCLUDE_DIRS})

# FIXME:
# This block came from config.cmake. please remove this and enable SOVERSION and VERSION properties.
# The spec file will also need to be modified.
IF (${HOST} STREQUAL "tizen")
    IF (${BACKEND} STREQUAL "efl_cairo_gl")
        SET (STARFISH_API_LDFLAGS ${STARFISH_API_LDFLAGS} -Wl,-soname,liblightweight-web-engine.so.1)
    ENDIF()
ENDIF()

IF (${ENABLE_DYNAMIC_LOADER} STREQUAL "1")
    MESSAGE (STATUS "ENABLE DYNAMIC_LOADER")
    ADD_LIBRARY (starfish_api.shared_library SHARED $<TARGET_OBJECTS:${STARFISH_API_OBJECT_LIBRARY}>)
    ADD_DEPENDENCIES(starfish_api.shared_library starfish.shared_library)
   
    GET_TARGET_PROPERTY(STARFISH_OUTPUT_NAME starfish.shared_library OUTPUT_NAME)
    SET (STARFISH_API_DEFINES
        ${STARFISH_API_DEFINES}
        -DSTARFISH_API_ENABLE_LOADER
        -DSTARFISH_API_DEFAULT_PATH="${STARFISH_API_DEFAULT_PATH}"
        -DSTARFISH_API_UWE_MOUNT_PATH="${STARFISH_API_UWE_MOUNT_PATH}"
        -DSTARFISH_API_TARGET_NAME="lib${STARFISH_OUTPUT_NAME}.so"
    )
    SET (STARFISH_API_LINK_LIBRARIES ${STARFISH_API_LINK_LIBRARIES} dl)
    
    TARGET_COMPILE_OPTIONS (${STARFISH_API_OBJECT_LIBRARY} PUBLIC ${LWE_CXXFLAGS} ${STARFISH_API_DEFINES})

    TARGET_LINK_LIBRARIES (starfish_api.shared_library ${STARFISH_API_LINK_LIBRARIES} ${STARFISH_API_LDFLAGS})

    SET_TARGET_PROPERTIES (starfish_api.shared_library PROPERTIES
        # SOVERSION 1
        OUTPUT_NAME ${TARGETNAME}
        # VERSION "1.0.0"
    )
ELSE()
    ADD_LIBRARY (starfish_api.shared_library SHARED $<TARGET_OBJECTS:${STARFISH_API_OBJECT_LIBRARY}>)
    ADD_LIBRARY (starfish_api.static_library STATIC $<TARGET_OBJECTS:${STARFISH_API_OBJECT_LIBRARY}>)
    ADD_DEPENDENCIES(starfish_api.shared_library starfish.shared_library)
    ADD_DEPENDENCIES(starfish_api.static_library starfish.static_library)

    TARGET_COMPILE_OPTIONS (${STARFISH_API_OBJECT_LIBRARY} PUBLIC ${LWE_CXXFLAGS} ${STARFISH_API_DEFINES})

    GET_TARGET_PROPERTY(STARFISH_OUTPUT_NAME starfish.shared_library OUTPUT_NAME)
    SET (STARFISH_API_LINK_LIBRARIES ${STARFISH_API_LINK_LIBRARIES} ${STARFISH_OUTPUT_NAME})

    TARGET_LINK_LIBRARIES (starfish_api.shared_library ${STARFISH_API_LINK_LIBRARIES} ${STARFISH_API_LDFLAGS})
    TARGET_LINK_LIBRARIES (starfish_api.static_library ${STARFISH_API_LINK_LIBRARIES} ${STARFISH_API_LDFLAGS})

    SET_TARGET_PROPERTIES (starfish_api.shared_library PROPERTIES
        # SOVERSION 1
        OUTPUT_NAME ${TARGETNAME}
        # VERSION "1.0.0"
    )
    SET_TARGET_PROPERTIES (starfish_api.static_library PROPERTIES OUTPUT_NAME ${TARGETNAME})
ENDIF()

MESSAGE (STATUS "Public API")
MESSAGE (STATUS "FLAGS: " "${LWE_CXXFLAGS}")
MESSAGE (STATUS "LIBRARIES: " "${STARFISH_API_LINK_LIBRARIES}")
MESSAGE (STATUS "DEFINITIONS: " "${STARFISH_API_DEFINES}")
MESSAGE (STATUS "LDFLAGS: " "${STARFISH_API_LDFLAGS}")
MESSAGE (STATUS "INCLUDE_DIRS: " "${STARFISH_API_INCLUDE_DIRS}")
