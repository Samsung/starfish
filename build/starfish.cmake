CMAKE_MINIMUM_REQUIRED (VERSION 2.8)

#######################################################
# SOURCE FILES
#######################################################
FILE (GLOB_RECURSE STARFISH_SRC ${STARFISH_ROOT}/src/*.cpp)

IF (${HOST} STREQUAL "tizen")
    FILE (GLOB STARFISH_SRC_EXTRA ${THIRD_PARTY_ROOT}/deviceapi/src/*.cpp)
ENDIF()

IF (NOT ${COMPONENT} STREQUAL "executable")
    LIST (REMOVE_ITEM STARFISH_SRC ${STARFISH_ROOT}/src/shell/shell.cpp ${STARFISH_ROOT}/src/shell/testRunner.cpp)
ENDIF()

IF (${CUSTOM} STREQUAL "prod_tv")
    LIST (REMOVE_ITEM STARFISH_SRC ${STARFISH_ROOT}/src/platform/tts/TTSBase.cpp ${STARFISH_ROOT}/src/platform/multimedia/MediaPlayerTizenBase.cpp)
ELSE()
    LIST (REMOVE_ITEM STARFISH_SRC ${STARFISH_ROOT}/src/platform/tts/TTSTV.cpp ${STARFISH_ROOT}/src/platform/multimedia/MediaPlayerTV.cpp)
ENDIF()

SET (STARFISH_SRC_LIST
    ${STARFISH_SRC}
    ${STARFISH_SRC_CUSTOM}
    ${STARFISH_SRC_EXTRA}
)

#######################################################
# INCLUDE DIRS
#######################################################
SET (STARFISH_INCLUDE_DIRS
    ${STARFISH_INCLUDE_DIRS_DEFAULT}
    ${STARFISH_BACKEND_INCLUDE_DIRS}
    ${STARFISH_BACKEND_ECORE_IMF_EVAS_INCLUDE_DIRS}
    ${STARFISH_BACKEND_LIBTBM_INCLUDE_DIRS}
    ${STARFISH_INCLUDE_DIRS_CUSTOM}
    ${STARFISH_INCLUDE_ADDITIONAL_DIRS}
    ${GCUTIL_ROOT}
    ${GCUTIL_ROOT}/bdwgc/include
    ${ESCARGOT_ROOT}/include
    ${ESCARGOT_ROOT}/src/api
    ${THIRD_PARTY_ROOT}/skia_matrix
    ${THIRD_PARTY_ROOT}/zeromq/include
    ${THIRD_PARTY_ROOT}/cppzmq
    ${THIRD_PARTY_ROOT}/clipper/cpp
    ${THIRD_PARTY_ROOT}/earcut.hpp/include/mapbox
    ${STARFISH_TIZEN_CUSTOM_INCLUDE_DIRS}
    ${STARFISH_TIZEN_CUSTOM_BUNDLE_INCLUDE_DIRS}
    ${STARFISH_TIZEN_CUSTOM_VCONF_INCLUDE_DIRS}
    ${STARFISH_TIZEN_INCLUDE_DIRS}
    ${STARFISH_ADDTIONAL_INCLUDE_DIRS}
)

#######################################################
# LINK LIBRARIES
#######################################################
SET (STARFISH_LINK_LIBRARIES
    ${STARFISH_LIBRARIES_DEFAULT}
    ${STARFISH_LIBRARIES_COMPILER}
    ${STARFISH_BACKEND_LIBRARIES}
    ${STARFISH_BACKEND_ECORE_IMF_EVAS_LIBRARIES}
    ${STARFISH_BACKEND_LIBTBM_LIBRARIES}
    ${STARFISH_LIBRARIES_BACKEND}
    ${STARFISH_LIBRARIES_HOST}
    ${STARFISH_LIBRARIES_CUSTOM}
    ${STARFISH_LIBRARIES_TOUCH_UI}
    ${STARFISH_LIBRARIES_THIRD_PARTY}
    ${STARFISH_TIZEN_CUSTOM_LIBRARIES}
    ${STARFISH_TIZEN_CUSTOM_BUNDLE_LIBRARIES}
    ${STARFISH_TIZEN_CUSTOM_VCONF_LIBRARIES}
    ${STARFISH_DALI_ADDTIONAL_LIBRARIES}
)

#######################################################
# BUILD TARGET
#######################################################
IF (${COMPONENT} STREQUAL "executable")
    ADD_EXECUTABLE (${TARGETNAME} ${STARFISH_SRC_LIST})
    IF (${ARCH} STREQUAL "x64")
        ADD_CUSTOM_COMMAND (TARGET ${TARGETNAME} POST_BUILD
            COMMAND ln -fs ${OUTPUT_DIRECTORY}/bin/${TARGETNAME} ${STARFISH_ROOT}/${TARGETNAME}
        )
    ENDIF()
ELSEIF (${COMPONENT} STREQUAL "shared_library")
    ADD_LIBRARY (${TARGETNAME} SHARED ${STARFISH_SRC_LIST})
ELSEIF (${COMPONENT} STREQUAL "static_library")
    ADD_LIBRARY (${TARGETNAME} STATIC ${STARFISH_SRC_LIST})
ELSE()
    MESSAGE (FATAL_ERROR "COMPONENT is NOT SET")
ENDIF()

SET (STARFISH_DEPENDENCIES_COMMON
    escargot
    clipper
    gc
)
IF (NOT ${CUSTOM} MATCHES "wearable")
    SET (STARFISH_DEPENDENCIES_CUSTOM mp4parse webm)
ENDIF()
IF (NOT ${BACKEND} STREQUAL "efl_skia")
    SET (STARFISH_DEPENDENCIES_BACKEND skia_matrix)
ENDIF()
IF (NOT ${HOST} STREQUAL "tizen")
    SET (STARFISH_DEPENDENCIES_HOST zmq)
ENDIF()
IF (${ARCH} STREQUAL "x64" AND (${BACKEND} STREQUAL "dali" OR ${BACKEND} STREQUAL "glfw_cairo_gl"))
    SET (STARFISH_DEPENDENCIES_EXTRA tuv)
ELSEIF (${HOST} STREQUAL "tizen" AND (${BACKEND} STREQUAL "ecore_wayland2_cairo_gl" OR ${BACKEND} STREQUAL "dali"))
    SET (STARFISH_DEPENDENCIES_EXTRA tuv)
ENDIF()
SET (STARFISH_DEPENDENCIES
    ${STARFISH_DEPENDENCIES_COMMON}
    ${STARFISH_DEPENDENCIES_CUSTOM}
    ${STARFISH_DEPENDENCIES_BACKEND}
    ${STARFISH_DEPENDENCIES_HOST}
    ${STARFISH_DEPENDENCIES_EXTRA}
)

ADD_DEPENDENCIES (${TARGETNAME} ${STARFISH_DEPENDENCIES})

#######################################################
# STARFISH TARGET
#######################################################
message ("FLAGS: " ${LWE_CXXFLAGS})
message ("LIBRARIES: " ${STARFISH_LINK_LIBRARIES})
message ("DEFINITIONS: " ${LWE_DEFINITIONS})
message ("LDFLAGS: " ${LWE_LDFLAGS})
message ("INCLUDE_DIRS: " ${STARFISH_INCLUDE_DIRS})

TARGET_INCLUDE_DIRECTORIES (${TARGETNAME} PUBLIC ${STARFISH_INCLUDE_DIRS})
TARGET_LINK_LIBRARIES (${TARGETNAME} ${STARFISH_LINK_LIBRARIES})
TARGET_COMPILE_DEFINITIONS (${TARGETNAME} PUBLIC ${LWE_DEFINITIONS})
TARGET_COMPILE_OPTIONS (${TARGETNAME} PUBLIC ${LWE_CXXFLAGS})
SET_TARGET_PROPERTIES (${TARGETNAME} PROPERTIES LINK_FLAGS ${LWE_LDFLAGS})
