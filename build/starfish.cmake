    ${STARFISH_ROOT}/src/public/LWELoaderUtils.cpp
    ${STARFISH_ROOT}/src/public/LWEDelegateLoader.cpp
    ${STARFISH_ROOT}/src/public/LWEWorker.cpp
    ${STARFISH_ROOT}/src/public/LWEWorkerDelegateLoader.cpp
    ${STARFISH_SHELL_SRC}
)

