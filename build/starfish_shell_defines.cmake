CMAKE_MINIMUM_REQUIRED (VERSION 2.8)

FUNCTION(SET_STARFISH_SHELL_DEFINES)
    SET(STARFISH_SHELL_DEFINES ${LWE_DEFINITIONS} PARENT_SCOPE)
    
    IF("${SHELL}" STREQUAL "efl" )
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_EFL PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "efl_headless")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_EFL_HEADLESS PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "x11")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_X11 PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "ecore_x")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_ECORE_X PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "ecore_wl2")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_ECORE_WL2 PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "tcore_wl")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_TCORE_WL PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "tcore_headless")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_TCORE_HEADLESS PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "glib_headless")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_GLIB_HEADLESS PARENT_SCOPE)
    ELSEIF ("${SHELL}" STREQUAL "x11_webcontainer")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_X11_WEBCONTAINER PARENT_SCOPE)
    ENDIF()
ENDFUNCTION()
