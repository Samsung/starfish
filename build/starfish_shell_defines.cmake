CMAKE_MINIMUM_REQUIRED (VERSION 2.8...4.0)

FUNCTION(SET_STARFISH_SHELL_DEFINES)
    # PARENT_SCOPE only writes the caller's copy of the variable -- it does NOT
    # update this function's own local STARFISH_SHELL_DEFINES, so each branch
    # below must keep accumulating locally and only publish PARENT_SCOPE once,
    # at the end. (Previously every SET(...PARENT_SCOPE) read back an empty
    # local STARFISH_SHELL_DEFINES, so the caller ended up with only the last
    # branch's single -DSTARFISH_SHELL_* flag instead of LWE_DEFINITIONS plus
    # it -- harmless today only because the caller happens to re-append
    # LWE_DEFINITIONS itself right after calling this function.)
    SET(STARFISH_SHELL_DEFINES ${LWE_DEFINITIONS})

    IF("${SHELL}" STREQUAL "efl" )
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_EFL)
    ELSEIF ("${SHELL}" STREQUAL "efl_headless")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_EFL_HEADLESS)
    ELSEIF ("${SHELL}" STREQUAL "x11")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_X11)
    ELSEIF ("${SHELL}" STREQUAL "ecore_x")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_ECORE_X)
    ELSEIF ("${SHELL}" STREQUAL "ecore_wl2")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_ECORE_WL2)
    ELSEIF ("${SHELL}" STREQUAL "tcore_wl")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_TCORE_WL)
    ELSEIF ("${SHELL}" STREQUAL "tcore_headless")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_TCORE_HEADLESS)
    ELSEIF ("${SHELL}" STREQUAL "glib_headless")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_GLIB_HEADLESS)
    ELSEIF ("${SHELL}" STREQUAL "x11_webcontainer")
        SET (STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} -DSTARFISH_SHELL_X11_WEBCONTAINER)
    ENDIF()

    SET(STARFISH_SHELL_DEFINES ${STARFISH_SHELL_DEFINES} PARENT_SCOPE)
ENDFUNCTION()
