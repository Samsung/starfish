#!/bin/bash
CONFDIR=$HOME/da/gbs-configuration/sac
BUILDDIR=$HOME/gbs-root/tizen-7.0/
mkdir -p ${BUILDDIR}

echo "==========================================="
echo " SELECT TARGET BUILD CONFIGURATION"
echo "==========================================="
echo "1.[MP] Prod-MP-Tizen-7.0-DA-SAC-DVMAI-25-Dev:aarch64"
echo "2.[MP] Prod-MP-Tizen-7.0-DA-SAC-DVMAI-25-Stg:aarch64"
echo "-------------------------------------------"
echo "0. Exit"
echo "==========================================="
read option

if [ -z "${option}" ];then
    exit
fi

case ${option} in
    0)
        exit 0
        ;;

    1)
        gbs -c ${CONFDIR}/dvmai/TIZEN_7.0_DA_SAC_GBS.conf build \
        --profile=profile.da_sac_dvmai_m64_aarch64_dev -A aarch64 --include-all --baselibs "$@"
        ;;

    2)
        gbs -c ${CONFDIR}/dvmai/TIZEN_7.0_DA_SAC_GBS.conf build \
        --profile=profile.da_sac_dvmai_m64_aarch64_stg -A aarch64 --include-all --baselibs "$@"
        ;;

    *)
        echo "Invalid choice"
    ;;
esac