#!/bin/bash
clear
CONFDIR=$HOME/tizen/spin/product/da/scm/meta/gbs-build-config
BUILDDIR=$HOME/gbs-root/tizen_4.0_spin
mkdir -p ${BUILDDIR}

echo "---------------------------------------"
echo " SELECT TARGET BUILD CONFIGURATION "
echo "---------------------------------------"
echo " 1.[AD] DA VCR VR9500P R18 32-bit"
echo " 2.[AD] DA VCR VR9500P R18 64-bit"
echo " 3.[AD] DA VCR VR9500P R18 i586 (32-bit)"
echo " 4.[AD] DA VCR VR9500P R18 x86_64 (64-bit)"
echo " 0. Exit"
echo "---------------------------------------"
read option

if [ -z "${option}" ];then
	exit
fi

case ${option} in
	0)
		exit 0
		;;

	1)
		gbs -c ${CONFDIR}/TIZEN_4.0_DA_VCR_GBS.conf build \
			--profile=profile.da_vcr_vr9500p_r18_arm32 -A armv7l --include-all $@
		;;
	2)
		gbs -c ${CONFDIR}/TIZEN_4.0_DA_VCR_GBS.conf build \
			--profile=profile.da_vcr_vr9500p_r18_arm64 -A aarch64 --include-all $@
		;;
	3)
		gbs -c ${CONFDIR}/TIZEN_4.0_DA_VCR_GBS.conf build \
			--profile=profile.da_vcr_vr9500p_r18_i586 -A i586 --include-all $@
		;;
	4)
		gbs -c ${CONFDIR}/TIZEN_4.0_DA_VCR_GBS.conf build \
			--profile=profile.da_vcr_vr9500p_r18_x86_64 -A x86_64 --include-all $@
		;;

	*)
		echo "Invalid choice"
		;;
esac
