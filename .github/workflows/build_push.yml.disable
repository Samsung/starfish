name: Build Starfish

on:
  push:
    branches: [ master ]

jobs:
  build_tizen_55:
    runs-on: [ self-hosted ]
    # runs-on: [ self-hosted,code-2xlarge ]
    container:
      image: art.sec.samsung.net/lws_docker/health_sdk/health-sdk:gbs
      options: --user root
    strategy:
      matrix:
        mode: [wearable, tv, mobile, x86_64, flutter_arm, flutter_arm64]

    # Set reasonable timeout value.
    timeout-minutes: 30

    steps:
      - name: Checkout source..
        uses: CODE-Actions/checkout@v2
        with:
          submodules: false

      - name: Reset Submodule
        run: git submodule foreach --recursive git reset --hard

      - name: Download a gbs.conf
        run: wget http://10.113.164.251:7000/gbs_confs/gbs.conf

      - name: Build wearable
        if: matrix.mode == 'wearable'
        run: gbs -c ./gbs.conf build -A armv7l -P profile.55std --include-all --incremental --define 'build_profile wearable'

      - name: Build tv
        if: matrix.mode == 'tv'
        run: gbs -c ./gbs.conf build -A armv7l -P profile.55std --include-all --incremental --define 'build_profile tv'

      - name: Build mobile
        if: matrix.mode == 'mobile'
        run: gbs -c ./gbs.conf build -A armv7l -P profile.55std --include-all --incremental --define 'build_profile mobile'

      - name: Build x86_64
        if: matrix.mode == 'x86_64'
        run: gbs -c ./gbs.conf build -A x86_64 -P profile.55emul --include-all --incremental 

      - name: Build flutter_arm
        if: matrix.mode == 'flutter_arm'
        run: gbs -c ./gbs.conf build -A armv7l -P profile.55std --include-all --incremental --define 'build_profile flutter'

      - name: Build flutter_arm64
        if: matrix.mode == 'flutter_arm64'
        run: gbs -c ./gbs.conf build -A aarch64 -P profile.55std --include-all --incremental --define 'build_profile flutter' 

      - uses: CODE-Actions/upload-artifact@v2
        if: matrix.mode == 'flutter_arm64'
        name: starfish-${{ matrix.mode }}
        with:
          path: | 
            ./out_tizen/flutter/release/lib/*.so

      - name: Leave comment
        if: ${{ failure() }}
        uses: CODE-Actions/github-script@v3
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            github.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: 'Please check the build status.'
            })

  build_x64:
    runs-on: [ self-hosted ]
    # runs-on: [ self-hosted,code-2xlarge ]
    container:
      image: art.sec.samsung.net/lws_docker/health_sdk/health-sdk:latest
      options: --user root
    strategy:
      matrix:
        mode: [x64_glfw_debug, x64_glfw_debug_wasm, x64_glfw_release, x64_efl_headless]

    # Set reasonable timeout value.
    timeout-minutes: 30

    steps:
      - name: Checkout source..
        uses: CODE-Actions/checkout@v2
        with:
          submodules: false

      - name: Reset Submodule
        run: git submodule foreach --recursive git reset --hard

      - name: Build Starfish
        run: /root/workspace/build.sh ${{ matrix.mode }}

      - name: Build image diff tool
        if: matrix.mode == 'x64_glfw_debug'
        run: ninja install_pixel_test_dep

      - uses: CODE-Actions/upload-artifact@v2
        name: starfish-${{ matrix.mode }}
        with:
          path: |
            ./out/debug/bin/lightweight-web-engine
            ./out/debug/lib/*.so

      - name: Leave comment
        if: ${{ failure() }}
        uses: CODE-Actions/github-script@v3
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            github.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: 'Please check the build status.'
            })
