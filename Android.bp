// Test Android.bp for LigthWeigth Web Engine


cc_prebuilt_library_static {
    name: "liblwe_prebuilt_static_cairo",
    compile_multilib: "32",
    multilib: {
        lib32: {
            srcs: [
                "third_party/prebuilt_armv-7a_8.1.0/lib/libcairo.a",
            ],
        },
    },
}


