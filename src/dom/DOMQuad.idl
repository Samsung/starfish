// https://drafts.fxtf.org/geometry/#DOMQuad

[
  UnimplementedConstructor(optional DOMPointInit p1, optional DOMPointInit p2, optional DOMPointInit p3, optional DOMPointInit p4),
 Exposed=(Window,Worker)]
interface DOMQuad {
  [Unimplemented, NewObject] static DOMQuad fromRect(optional DOMRectInit other);
  [Unimplemented, NewObject] static DOMQuad fromQuad(optional DOMQuadInit other);

  [SameObject] readonly attribute DOMPoint p1;
  [SameObject] readonly attribute DOMPoint p2;
  [SameObject] readonly attribute DOMPoint p3;
  [SameObject] readonly attribute DOMPoint p4;
  [Unimplemented, NewObject] DOMRect getBounds();

  serializer = { attribute };
};
