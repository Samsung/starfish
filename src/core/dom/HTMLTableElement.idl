// https://html.spec.whatwg.org/#the-table-element

[HTMLConstructor]
interface HTMLTableElement : HTMLElement {
  [CEReactions, RaisesException=Setter] attribute HTMLTableCaptionElement? caption;
  [CEReactions] HTMLTableCaptionElement createCaption();
  [CEReactions] void deleteCaption();

  [Unimplemented, CEReactions] attribute HTMLTableSectionElement? tHead;
  [Unimplemented] HTMLTableSectionElement createTHead();
  [Unimplemented, CEReactions] void deleteTHead();

  [Unimplemented, CEReactions] attribute HTMLTableSectionElement? tFoot;
  [Unimplemented] HTMLTableSectionElement createTFoot();
  [Unimplemented, CEReactions] void deleteTFoot();

  [Unimplemented, SameObject] readonly attribute HTMLCollection tBodies;
  [Unimplemented] HTMLTableSectionElement createTBody();

  [SameObject] readonly attribute HTMLCollection rows;
  [Unimplemented] HTMLTableRowElement insertRow(optional long index = -1);
  [Unimplemented, CEReactions] void deleteRow(long index);

  // also has obsolete members
  // https://html.spec.whatwg.org/#HTMLTableElement-partial
  [CEReactions, Reflect] attribute DOMString align;
  [Unimplemented, CEReactions] attribute DOMString border;
  [Unimplemented, CEReactions] attribute DOMString frame;
  [Unimplemented, CEReactions] attribute DOMString rules;
  [Unimplemented, CEReactions] attribute DOMString summary;
  [CEReactions, Reflect] attribute DOMString width;

  [CEReactions, TreatNullAs=EmptyString, Reflect] attribute DOMString bgColor;
  [Unimplemented, CEReactions, TreatNullAs=EmptyString] attribute DOMString cellPadding;
  [Unimplemented, CEReactions, TreatNullAs=EmptyString] attribute DOMString cellSpacing;
};
