// https://drafts.fxtf.org/geometry/#DOMQuad
// NOTE It seems that constructor does not have optional arguments
//      So remove optional expression from arguments
//      Leave here original constructor for reference
//      Constructor(optional DOMPointInit p1, optional DOMPointInit p2, optional DOMPointInit p3, optional DOMPointInit p4)
[
  Constructor(DOMPointInit p1, DOMPointInit p2, DOMPointInit p3, DOMPointInit p4),
  ConstructorCallWith=Document,
  Exposed=(Window,Worker)]
interface DOMQuad {
  [Unimplemented, NewObject] static DOMQuad fromRect(optional DOMRectInit other);
  [Unimplemented, NewObject] static DOMQuad fromQuad(optional DOMQuadInit other);

  [SameObject] readonly attribute DOMPoint p1;
  [SameObject] readonly attribute DOMPoint p2;
  [SameObject] readonly attribute DOMPoint p3;
  [SameObject] readonly attribute DOMPoint p4;
  [NewObject] DOMRect getBounds();

  serializer = { attribute };
};
