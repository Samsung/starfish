// https://html.spec.whatwg.org/#the-textarea-element

[HTMLConstructor]
interface HTMLTextAreaElement : HTMLElement {
    [Unimplemented, CEReactions] attribute DOMString autocomplete;
    [CEReactions, Reflect] attribute boolean autofocus;
    [CEReactions] attribute unsigned long cols;
    [CEReactions, Reflect] attribute DOMString dirName;
    [CEReactions, Reflect] attribute boolean disabled;
    readonly attribute HTMLFormElement? form;
    [Unimplemented, CEReactions] attribute DOMString inputMode;
    [CEReactions, RaisesException=Setter] attribute long maxLength;
    [CEReactions, RaisesException=Setter] attribute long minLength;
    [CEReactions, Reflect] attribute DOMString name;
    [CEReactions, Reflect] attribute DOMString placeholder;
    [CEReactions, Reflect] attribute boolean readOnly;
    [CEReactions, Reflect] attribute boolean required;
    [CEReactions] attribute unsigned long rows;
    [Unimplemented, CEReactions] attribute DOMString wrap;

    readonly attribute DOMString type;
    [CEReactions] attribute DOMString defaultValue;
    [TreatNullAs=EmptyString, CEReactions, Rename=apiValue] attribute DOMString value;
    readonly attribute unsigned long textLength;

    [Unimplemented] readonly attribute boolean willValidate;
    [Unimplemented] readonly attribute ValidityState validity;
    [Unimplemented] readonly attribute DOMString validationMessage;
    [Unimplemented] boolean checkValidity();
    [Unimplemented] boolean reportValidity();
    [Unimplemented] void setCustomValidity(DOMString error);

    readonly attribute NodeList labels;

    [Unimplemented] void select();
    [Unimplemented] attribute unsigned long selectionStart;
    [Unimplemented] attribute unsigned long selectionEnd;
    [Unimplemented] attribute DOMString selectionDirection;
    [Unimplemented] void setRangeText(DOMString replacement);
    [Unimplemented] void setRangeText(DOMString replacement, unsigned long start, unsigned long end, optional SelectionMode selectionMode = "preserve");
    [Unimplemented] void setSelectionRange(unsigned long start, unsigned long end, optional DOMString direction);
};
