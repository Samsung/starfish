// https://html.spec.whatwg.org/multipage/semantics.html#the-body-element

[HTMLConstructor]
interface HTMLBodyElement : HTMLElement {
  // The onblur, onerror, onfocus, onload, onresize, and onscroll event handlers of the Window object, exposed on the body element, replace the generic event handlers with the same names normally supported by HTML elements.
  attribute EventHandler onblur;
  attribute EventHandler onerror;
  attribute EventHandler onfocus;
  attribute EventHandler onload;
  attribute EventHandler onresize;
  [Unimplemented] attribute EventHandler onscroll;

  [CEReactions, Reflect] attribute DOMString aLink;
  [CEReactions, Reflect] attribute DOMString bgColor;
  [CEReactions, Reflect] attribute DOMString background;
  [CEReactions, Reflect] attribute DOMString link;
  [CEReactions, Reflect] attribute DOMString text;
  [CEReactions, Reflect] attribute DOMString vLink;
};

HTMLBodyElement implements WindowEventHandlers;

