// https://w3c.github.io/DOM-Parsing/#the-domparser-interface

enum SupportedType {
  "text/html",
  "text/xml",
  "application/xml",
  "application/xhtml+xml",
  "image/svg+xml"
};

[
  Constructor,
  ConstructorCallWith=Document
] interface DOMParser {
  [RaisesException, NewObject] Document parseFromString(DOMString str, SupportedType type);
};
