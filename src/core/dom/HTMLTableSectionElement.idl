// https://html.spec.whatwg.org/#htmltablesectionelement

[HTMLConstructor]
interface HTMLTableSectionElement : HTMLElement {
  [Unimplemented, SameObject] readonly attribute HTMLCollection rows;
  [Unimplemented] HTMLElement insertRow(optional long index = -1);
  [Unimplemented, CEReactions] void deleteRow(long index);

  // also has obsolete members
  // https://html.spec.whatwg.org/#HTMLTableSectionElement-partial
  [CEReactions, Reflect] attribute DOMString align;
  [CEReactions] attribute DOMString ch;
  [CEReactions, Reflect] attribute DOMString chOff;
  [CEReactions, Reflect] attribute DOMString vAlign;
};
