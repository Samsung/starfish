// https://html.spec.whatwg.org/#forms

[OverrideBuiltins, LegacyUnenumerableNamedProperties, HTMLConstructor]
interface HTMLFormElement : HTMLElement {
    [Unimplemented, CEReactions] attribute DOMString acceptCharset;
    [CEReactions] attribute USVString action;
    [Unimplemented, CEReactions] attribute DOMString autocomplete;
    [CEReactions] attribute DOMString enctype;
    [Unimplemented, CEReactions] attribute DOMString encoding;
    [CEReactions] attribute DOMString method;
    [CEReactions, Rename=domName] attribute DOMString name;
    [Unimplemented, CEReactions] attribute boolean noValidate;
    [CEReactions] attribute DOMString target;

    [Unimplemented, SameObject] readonly attribute HTMLFormControlsCollection elements;
    [Unimplemented] readonly attribute unsigned long length;
    // [Unimplemented] getter Element (unsigned long index);
    // [Unimplemented] getter (RadioNodeList or Element) (DOMString name);

    void submit();
    [Unimplemented, CEReactions] void reset();
    [Unimplemented] boolean checkValidity();
    [Unimplemented] boolean reportValidity();
};

