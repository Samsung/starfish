// https://drafts.csswg.org/css-animations/#interface-animationevent

dictionary AnimationEventInit : EventInit {
  CSSOMString animationName = "";
  float elapsedTime = 0.0;
  [Unimplemented] CSSOMString pseudoElement = "";
};

[Exposed=Window,
 Constructor(DOMString type, optional AnimationEventInit animationEventInitDict), ConstructorCallWith=ExecutionContext]
interface AnimationEvent : Event {
  readonly attribute CSSOMString animationName;
  readonly attribute float elapsedTime;
  [Unimplemented] readonly attribute CSSOMString pseudoElement;
};

