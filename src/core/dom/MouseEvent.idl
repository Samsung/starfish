// https://w3c.github.io/uievents/#idl-mouseeventinit
dictionary MouseEventInit : EventModifierInit {
  double screenX = 0;
  double screenY = 0;
  double clientX = 0;
  double clientY = 0;

  short button = 0;
  unsigned short buttons = 0;
  EventTarget? relatedTarget = null;
};

// https://w3c.github.io/uievents/#idl-mouseevent
[Constructor(DOMString type, optional MouseEventInit eventInitDict), ConstructorCallWith=Document]
interface MouseEvent : UIEvent {
  readonly attribute long screenX;
  readonly attribute long screenY;
  readonly attribute long clientX;
  readonly attribute long clientY;

  [Unimplemented] readonly attribute boolean ctrlKey;
  [Unimplemented] readonly attribute boolean shiftKey;
  [Unimplemented] readonly attribute boolean altKey;
  [Unimplemented] readonly attribute boolean metaKey;

  readonly attribute short button;
  readonly attribute unsigned short buttons;

  readonly attribute EventTarget? relatedTarget;
  [Unimplemented] boolean getModifierState(DOMString keyArg);

  // The initMouseEvent method is deprecated, but supported for backwards-compatibility with widely-deployed implementations.
  void initMouseEvent(DOMString type,
                      optional boolean bubbles = false,
                      optional boolean cancelable = false,
                      optional Window? view = null,
                      optional long detail = 0,
                      optional long screenX = 0,
                      optional long screenY = 0,
                      optional long clientX = 0,
                      optional long clientY = 0,
                      optional boolean ctrlKey = false,
                      optional boolean altKey = false,
                      optional boolean shiftKey = false,
                      optional boolean metaKey = false,
                      optional unsigned short button = 0,
                      optional EventTarget? relatedTarget = null);
};
