// https://drafts.fxtf.org/geometry/#DOMMatrix
[Constructor(optional (DOMString or sequence<unrestricted double>) init),
 ConstructorCallWith=ExecutionContext,
 Exposed=(Window,Worker),
 Serializable
 ]
interface DOMMatrixReadOnly {
    [Unimplemented,NewObject] static DOMMatrixReadOnly fromMatrix(optional DOMMatrixInit other);
    [Unimplemented,NewObject] static DOMMatrixReadOnly fromFloat32Array(Float32Array array32);
    [Unimplemented,NewObject] static DOMMatrixReadOnly fromFloat64Array(Float64Array array64);

    // These attributes are simple aliases for certain elements of the 4x4 matrix
    readonly attribute unrestricted double a;
    readonly attribute unrestricted double b;
    readonly attribute unrestricted double c;
    readonly attribute unrestricted double d;
    readonly attribute unrestricted double e;
    readonly attribute unrestricted double f;

    readonly attribute unrestricted double m11;
    readonly attribute unrestricted double m12;
    readonly attribute unrestricted double m13;
    readonly attribute unrestricted double m14;
    readonly attribute unrestricted double m21;
    readonly attribute unrestricted double m22;
    readonly attribute unrestricted double m23;
    readonly attribute unrestricted double m24;
    readonly attribute unrestricted double m31;
    readonly attribute unrestricted double m32;
    readonly attribute unrestricted double m33;
    readonly attribute unrestricted double m34;
    readonly attribute unrestricted double m41;
    readonly attribute unrestricted double m42;
    readonly attribute unrestricted double m43;
    readonly attribute unrestricted double m44;

    [Unimplemented] readonly attribute boolean is2D;
    [Unimplemented] readonly attribute boolean isIdentity;

    // Immutable transform methods
    [Unimplemented,NewObject] DOMMatrix translate(optional unrestricted double tx = 0,
                                    optional unrestricted double ty = 0,
                                    optional unrestricted double tz = 0);
    [Unimplemented,NewObject] DOMMatrix scale(optional unrestricted double scaleX = 1,
                                optional unrestricted double scaleY,
                                optional unrestricted double scaleZ = 1,
                                optional unrestricted double originX = 0,
                                optional unrestricted double originY = 0,
                                optional unrestricted double originZ = 0);
    [Unimplemented,NewObject] DOMMatrix scaleNonUniform(optional unrestricted double scaleX = 1,
                                          optional unrestricted double scaleY = 1);
    [Unimplemented,NewObject] DOMMatrix scale3d(optional unrestricted double scale = 1,
                                  optional unrestricted double originX = 0,
                                  optional unrestricted double originY = 0,
                                  optional unrestricted double originZ = 0);
    [Unimplemented,NewObject] DOMMatrix rotate(optional unrestricted double rotX = 0,
                                 optional unrestricted double rotY,
                                 optional unrestricted double rotZ);
    [Unimplemented,NewObject] DOMMatrix rotateFromVector(optional unrestricted double x = 0,
                                           optional unrestricted double y = 0);
    [Unimplemented,NewObject] DOMMatrix rotateAxisAngle(optional unrestricted double x = 0,
                                          optional unrestricted double y = 0,
                                          optional unrestricted double z = 0,
                                          optional unrestricted double angle = 0);
    [Unimplemented,NewObject] DOMMatrix skewX(optional unrestricted double sx = 0);
    [Unimplemented,NewObject] DOMMatrix skewY(optional unrestricted double sy = 0);
    [Unimplemented,NewObject] DOMMatrix multiply(optional DOMMatrixInit other);
    [Unimplemented,NewObject] DOMMatrix flipX();
    [Unimplemented,NewObject] DOMMatrix flipY();
    [Unimplemented,NewObject] DOMMatrix inverse();

    [Unimplemented,NewObject] DOMPoint transformPoint(optional DOMPointInit point);
    [Unimplemented,NewObject] Float32Array toFloat32Array();
    [Unimplemented,NewObject] Float64Array toFloat64Array();

    [Unimplemented,Exposed=Window] stringifier;
    [Unimplemented,Default] object toJSON();
};