// https://www.w3.org/TR/SVG11/shapes.html#InterfaceSVGRectElement
// TODO implement SVGTests, SVGLangSpace, SVGExternalResourcesRequired, SVGStylable, SVGTransformable 
interface SVGRectElement : SVGElement {
  [Unimplemented] readonly attribute SVGAnimatedLength x;
  [Unimplemented] readonly attribute SVGAnimatedLength y;
  [Unimplemented] readonly attribute SVGAnimatedLength width;
  [Unimplemented] readonly attribute SVGAnimatedLength height;
  [Unimplemented] readonly attribute SVGAnimatedLength rx;
  [Unimplemented] readonly attribute SVGAnimatedLength ry;
};