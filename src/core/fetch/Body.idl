// typedef (Blob or BufferSource or FormData or URLSearchParams or ReadableStream or USVString) BodyInit;
typedef (Blob or BufferSource or USVString) BodyInit;

// mixin
[PartialInterface,
 NoInterfaceObject]
interface Body {
  // NOTE: ReadableStream -> BodyInit is possible
  // readonly attribute ReadableStream? body;

  readonly attribute BodyInit? body;
  readonly attribute boolean bodyUsed;
  [NewObject] Promise<ArrayBuffer> arrayBuffer();
  [NewObject] Promise<Blob> blob();
  [NewObject] Promise<FormData> formData();
  [NewObject] Promise<any> json();
  [NewObject] Promise<USVString> text();

};
