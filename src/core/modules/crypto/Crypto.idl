// https://w3c.github.io/webcrypto/#crypto-interface

// partial interface mixin WindowOrWorkerGlobalScope {
//   [SameObject] readonly attribute Crypto crypto;
// };

partial interface Window {
  [SameObject] readonly attribute Crypto crypto;
};

partial interface WorkerGlobalScope {
  [SameObject] readonly attribute Crypto crypto;
};

[  ConstructorCallWith=ExecutionContext,
   Exposed=(Window,Worker)]
interface Crypto {
  // NOTE The binding generator does not enforce [SecureContext] yet.
  [STARFISH_ENABLE_WEBCRYPTO, SecureContext] readonly attribute SubtleCrypto subtle;
  [RaisesException] ArrayBufferView getRandomValues(ArrayBufferView array);
  [STARFISH_ENABLE_WEBCRYPTO, SecureContext] DOMString randomUUID();
};
