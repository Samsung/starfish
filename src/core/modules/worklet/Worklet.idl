// https://html.spec.whatwg.org/multipage/worklets.html#worklets-worklet
// AudioWorklet is the only worklet type, so Worklet shares its build flag.
[ STARFISH_ENABLE_AUDIO_WORKLET,
  Exposed=Window ]
interface Worklet {
  [NewObject] Promise<void> addModule(USVString moduleURL, optional WorkletOptions options);
};

[ STARFISH_ENABLE_AUDIO_WORKLET ]
dictionary WorkletOptions {
  RequestCredentials credentials = "same-origin";
};
