// https://w3c.github.io/ServiceWorker/#serviceworkercontainer-interface

[STARFISH_ENABLE_SERVICE_WORKER, SecureContext, Exposed=(Window,Worker)]
interface ServiceWorkerContainer : EventTarget {
  readonly attribute ServiceWorker? controller;
  // readonly attribute Promise<ServiceWorkerRegistration> ready;

  // [NewObject] Promise<ServiceWorkerRegistration> register(USVString scriptURL, optional RegistrationOptions options);
  [Rename=registerServiceWorker]Promise<void> register(USVString scriptURL, optional RegistrationOptions options);

  [NewObject] Promise<void> getRegistration(optional USVString clientURL = "");
  // [NewObject] Promise<any> getRegistration(optional USVString clientURL = "");
  [NewObject] Promise<FrozenArray<ServiceWorkerRegistration>> getRegistrations();

  [Unimplemented] void startMessages();


  // events
  [Unimplemented] attribute EventHandler oncontrollerchange;
  [Unimplemented] attribute EventHandler onmessage; // event.source of message events is ServiceWorker object
  [Unimplemented] attribute EventHandler onmessageerror;
};
