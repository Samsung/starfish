// https://webaudio.github.io/web-audio-api/#AudioWorkletProcessor
// The constructor takes the global scope's pending processor construction
// data (src/binding/AudioWorkletProcessorCustomBinding.cpp).
[ STARFISH_ENABLE_AUDIO_WORKLET,
  CustomConstructor,
  Exposed=AudioWorklet ]
interface AudioWorkletProcessor {
  readonly attribute MessagePort port;
};
