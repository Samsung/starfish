// https://html.spec.whatwg.org/multipage/workers.html#dedicated-workers-and-the-worker-interface

[ STARFISH_ENABLE_WORKER,
  Exposed=(Window,DedicatedWorker,SharedWorker),
  Constructor(USVString scriptURL, optional WorkerOptions options /* = {} */),
  RaisesException=Constructor,
  ConstructorCallWith=ExecutionContext,
]
interface Worker : EventTarget {
  [Unimplemented] void terminate();

  [Unimplemented, RaisesException] void postMessage(any message, sequence<object> transfer);
  [Unimplemented, RaisesException] void postMessage(any message, optional StructuredSerializeOptions options  /* = {} */);

  [Unimplemented] attribute EventHandler onmessage;
  [Unimplemented] attribute EventHandler onmessageerror;
};

[STARFISH_ENABLE_WORKER]
dictionary WorkerOptions {
  WorkerType type = "classic";
  RequestCredentials credentials = "same-origin"; // credentials is only used if type is "module"
  DOMString name = "";
};

[STARFISH_ENABLE_WORKER]
enum WorkerType { "classic", "module" };

// includes -> implements
Worker implements AbstractWorker;
