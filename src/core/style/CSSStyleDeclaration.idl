// https://dev.w3.org/csswg/cssom/#the-cssstyledeclaration-interface

interface CSSStyleDeclaration {
  [CEReactions] attribute DOMString cssText;
  readonly attribute unsigned long length;
  getter DOMString item(unsigned long index);
  DOMString getPropertyValue(DOMString property);
  DOMString getPropertyPriority(DOMString property);
  [CEReactions, RaisesException] void setProperty(DOMString property, [TreatNullAs=EmptyString] DOMString value, [TreatNullAs=EmptyString] optional DOMString priority = "");
  [Unimplemented, CEReactions, RaisesException] DOMString removeProperty(DOMString property);
  readonly attribute CSSRule? parentRule;
  [CEReactions, TreatNullAs=EmptyString] attribute DOMString cssFloat;

  // NOTE add getter&setter for named access
  getter DOMString? (DOMString property);
  [RaisesException] setter void (DOMString property, DOMString? propertyValue);
};
