// https://w3c.github.io/FileAPI/#file-section

[Constructor,ConstructorCallWith=ExecutionContext
,Exposed=(Window,Worker)]
interface FileReader: EventTarget {
  // constructor();

  // async read methods
  // change undefined -> void
  [RaisesException] undefined readAsArrayBuffer(Blob blob);
  [Unimplemented, RaisesException] void readAsBinaryString(Blob blob);
  [RaisesException] void readAsText(Blob blob, optional DOMString encoding);
  [Unimplemented, RaisesException] void readAsDataURL(Blob blob);

  void abort();

  // states
  const unsigned short EMPTY = 0;
  const unsigned short LOADING = 1;
  const unsigned short DONE = 2;

  readonly attribute unsigned short readyState;

  // File or Blob data
  readonly attribute (DOMString or ArrayBuffer)? result;

  [Unimplemented] readonly attribute DOMException? error;

  // event handler content attributes
  attribute EventHandler onloadstart;
  attribute EventHandler onprogress;
  attribute EventHandler onload;
  attribute EventHandler onabort;
  attribute EventHandler onerror;
  attribute EventHandler onloadend;
};
