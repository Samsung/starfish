// https://html.spec.whatwg.org/#the-window-object
// NOTE Using DOMString instead of USVString

enum ScrollBehavior { "auto", "instant", "smooth" };

dictionary ScrollOptions {
    ScrollBehavior behavior = "auto";
};
dictionary ScrollToOptions : ScrollOptions {
    unrestricted double left;
    unrestricted double top;
};

[PrimaryGlobal, LegacyUnenumerableNamedProperties, CustomDescriptor]
interface Window : EventTarget {
  // the current browsing context
  // NOTE WindowProxy -> Window
  [Unforgeable] readonly attribute Window window;
  // `self` is Implemented in virtual id
  // [Replaceable] readonly attribute WindowProxy self;
  [Unforgeable] readonly attribute Document document;
  attribute DOMString name;
  [PutForwards=href, Unforgeable] readonly attribute Location location;
  readonly attribute History history;
  [Unimplemented] readonly attribute CustomElementRegistry customElements;
  [Unimplemented, Replaceable] readonly attribute BarProp locationbar;
  [Unimplemented, Replaceable] readonly attribute BarProp menubar;
  [Unimplemented, Replaceable] readonly attribute BarProp personalbar;
  [Unimplemented, Replaceable] readonly attribute BarProp scrollbars;
  [Unimplemented, Replaceable] readonly attribute BarProp statusbar;
  [Unimplemented, Replaceable] readonly attribute BarProp toolbar;
  [Unimplemented] attribute DOMString status;
  [Unimplemented] void close();
  [Unimplemented] readonly attribute boolean closed;
  [Unimplemented] void stop();
  void focus();
  void blur();

  // other browsing contexts
  // NOTE WindowProxy -> Window
  [Replaceable] readonly attribute Window frames;
  [Replaceable] readonly attribute unsigned long length;

  // NOTE WindowProxy -> Window
  [Unforgeable] readonly attribute Window? top;
  [Unimplemented] attribute any opener;
  // NOTE WindowProxy -> Window
  [Replaceable] readonly attribute Window? parent;
  readonly attribute Element? frameElement;
  [Unimplemented] WindowProxy? open(optional DOMString url = "about:blank", optional DOMString target = "_blank", [TreatNullAs=EmptyString] optional DOMString features = "");
  [Unimplemented, NotEnumerable] getter object (DOMString name);
  [Unimplemented, NotEnumerable] getter Window (unsigned long index);

  // the user agent
  readonly attribute Navigator navigator;
  [Unimplemented] readonly attribute ApplicationCache applicationCache;

  // user prompts
  [Unimplemented] void alert();
  [Unimplemented] void alert(DOMString message);
  [Unimplemented] boolean confirm(optional DOMString message = "");
  [Unimplemented] DOMString? prompt(optional DOMString message = "", optional DOMString default = "");
  [Unimplemented] void print();

  [Custom] unsigned long requestAnimationFrame(FrameRequestCallback callback);
  void cancelAnimationFrame(unsigned long handle);

  // NOTE transfer: sequence<object> -> sequence<any>
  [RaisesException] void postMessage(any message, DOMString targetOrigin, optional sequence<any> transfer);

  // https://html.spec.whatwg.org/#Window-partial
  [Unimplemented] void captureEvents();
  [Unimplemented] void releaseEvents();

  [Unimplemented, Replaceable, SameObject] readonly attribute External external;

  // https://drafts.csswg.org/cssom/#extensions-to-the-window-interface
  [NewObject] CSSStyleDeclaration getComputedStyle(Element elt, optional CSSOMString? pseudoElt);

  // https://drafts.csswg.org/cssom-view/#extensions-to-the-window-interface
  [NewObject] MediaQueryList matchMedia(CSSOMString query);
  [SameObject, Replaceable] readonly attribute Screen screen;

  // browsing context
  [Unimplemented] void moveTo(long x, long y);
  [Unimplemented] void moveBy(long x, long y);
  [Unimplemented] void resizeTo(long x, long y);
  [Unimplemented] void resizeBy(long x, long y);

  // viewport
  [Replaceable] readonly attribute long innerWidth;
  [Replaceable] readonly attribute long innerHeight;

  // viewport scrolling
  [Replaceable] readonly attribute double scrollX;
  [Replaceable] readonly attribute double pageXOffset;
  [Replaceable] readonly attribute double scrollY;
  [Replaceable] readonly attribute double pageYOffset;
  void scroll(optional ScrollToOptions options);
  void scroll(unrestricted double x, unrestricted double y);
  void scrollTo(optional ScrollToOptions options);
  void scrollTo(unrestricted double x, unrestricted double y);
  [Unimplemented] void scrollBy(optional ScrollToOptions options);
  [Unimplemented] void scrollBy(unrestricted double x, unrestricted double y);

  // client
  [Unimplemented, Replaceable] readonly attribute long screenX;
  [Unimplemented, Replaceable] readonly attribute long screenY;
  [Unimplemented, Replaceable] readonly attribute long outerWidth;
  [Unimplemented, Replaceable] readonly attribute long outerHeight;
  [Replaceable] readonly attribute double devicePixelRatio;
};

Window implements GlobalEventHandlers;
Window implements WindowEventHandlers;

callback FrameRequestCallback = void (DOMHighResTimeStamp time);

// https://html.spec.whatwg.org/#windoworworkerglobalscope

typedef (DOMString or Function) TimerHandler;

[PartialInterface,
 NoInterfaceObject,
 Exposed=(Window,Worker)]
interface WindowOrWorkerGlobalScope {
  [Unimplemented, Replaceable] readonly attribute USVString origin;

  // base64 utility methods
  [Unimplemented] DOMString btoa(DOMString data);
  [Unimplemented] DOMString atob(DOMString data);

  // timers
  [Custom] long setTimeout(TimerHandler handler, optional long timeout = 0, any... arguments);
  void clearTimeout(optional long handle = 0);
  [Custom] long setInterval(TimerHandler handler, optional long timeout = 0, any... arguments);
  void clearInterval(optional long handle = 0);

  // ImageBitmap
  [Unimplemented] Promise<ImageBitmap> createImageBitmap(ImageBitmapSource image, optional ImageBitmapOptions options);
  [Unimplemented] Promise<ImageBitmap> createImageBitmap(ImageBitmapSource image, long sx, long sy, long sw, long sh, optional ImageBitmapOptions options);
};

Window implements WindowOrWorkerGlobalScope;
// WorkerGlobalScope implements WindowOrWorkerGlobalScope;

// https://html.spec.whatwg.org/#windowlocalstorage
[PartialInterface,
 NoInterfaceObject]
interface WindowLocalStorage {
  readonly attribute Storage localStorage;
};
Window implements WindowLocalStorage;

// https://html.spec.whatwg.org/#windowsessionstorage
[PartialInterface,
 NoInterfaceObject]
interface WindowSessionStorage {
  readonly attribute Storage sessionStorage;
};
Window implements WindowSessionStorage;


